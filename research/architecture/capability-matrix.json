{
  "schema": "aetheria_capability_matrix_v1",
  "version": 1,
  "default_model_calls": 0,
  "default_network": false,
  "stages": [
    "specified",
    "local_deterministic_prototype",
    "sandboxed_operational",
    "controlled_external_use",
    "production_candidate",
    "production_approved"
  ],
  "forbidden_automatic": [
    "irreversible_external_actions_without_approval",
    "private_systems_without_authorization",
    "production_modification_by_research",
    "permission_expansion",
    "unrestricted_recursive_delegation",
    "trusting_generated_code_or_plans",
    "unbounded_memory_retention",
    "self_modification_of_live_models_or_production_policies"
  ],
  "capabilities": [
    {
      "id": "goal_interpretation",
      "purpose": "Parse a user goal into a bounded objective or a refusal.",
      "inputs": ["natural_language_goal"],
      "outputs": ["goal_record", "in_scope_flag"],
      "evidence": ["goal_record.json"],
      "allowed_tools": ["none"],
      "resource_limits": {"max_model_calls": 0},
      "failure_modes": ["underspecified", "out_of_scope"],
      "recovery": "ask_clarification_or_refuse",
      "approval": "none_for_classification",
      "eligibility": "research-only",
      "maturity": "specified",
      "next_maturity": "local_deterministic_prototype",
      "evaluator": "research.evaluate",
      "safety_controls": ["no_network", "no_production_paths"],
      "acceptance_criteria": ["emits structured goal_record", "does_not_execute_tools"],
      "blocking_risks": ["over_acceptance"],
      "owner": "research",
      "dependencies": []
    },
    {
      "id": "clarification",
      "purpose": "Ask or flag missing constraints instead of guessing.",
      "inputs": ["goal_record", "ambiguity_markers"],
      "outputs": ["clarification_questions", "uncertainty_flag"],
      "evidence": ["ambiguity_record.json"],
      "allowed_tools": ["none"],
      "resource_limits": {"max_model_calls": 0},
      "failure_modes": ["false_certainty"],
      "recovery": "escalate_uncertainty",
      "approval": "user_if_blocking",
      "eligibility": "research-only",
      "maturity": "local_deterministic_prototype",
      "next_maturity": "sandboxed_operational",
      "evaluator": "research.evaluate:ambiguity_uncertainty",
      "safety_controls": ["no_guess_when_critic_or_coordinator_required"],
      "acceptance_criteria": ["uncertainty_flag_when_senses_gt_1"],
      "blocking_risks": ["silent_assumption"],
      "owner": "research",
      "dependencies": ["goal_interpretation"]
    },
    {
      "id": "bounded_planning",
      "purpose": "Emit an ordered, budgeted plan.",
      "inputs": ["goal_record", "resource_budget"],
      "outputs": ["plan_steps"],
      "evidence": ["plan.json"],
      "allowed_tools": ["none"],
      "resource_limits": {"max_task_depth": 4, "max_active_workers": 8},
      "failure_modes": ["unordered_parallel_on_chain"],
      "recovery": "stop_and_report",
      "approval": "none_in_research",
      "eligibility": "research-only",
      "maturity": "local_deterministic_prototype",
      "next_maturity": "sandboxed_operational",
      "evaluator": "research.evaluate:dependent_planning",
      "safety_controls": ["depth_clamp", "no_recursive_spawn"],
      "acceptance_criteria": ["ordered_steps_when_deps_present"],
      "blocking_risks": ["fan_in_on_chains"],
      "owner": "research",
      "dependencies": ["goal_interpretation"]
    },
    {
      "id": "research_synthesis",
      "purpose": "Join evidence across documents.",
      "inputs": ["docs[]"],
      "outputs": ["joined_record"],
      "evidence": ["synthesis.json"],
      "allowed_tools": ["none"],
      "resource_limits": {"max_model_calls": 0},
      "failure_modes": ["single_doc_pass"],
      "recovery": "report_incomplete_join",
      "approval": "none_in_research",
      "eligibility": "research-only",
      "maturity": "local_deterministic_prototype",
      "next_maturity": "sandboxed_operational",
      "evaluator": "research.evaluate:multi_doc_synthesis",
      "safety_controls": ["local_docs_only"],
      "acceptance_criteria": ["join_requires_multi_role_or_pipeline"],
      "blocking_risks": ["hallucinated_fields"],
      "owner": "research",
      "dependencies": ["bounded_planning"]
    },
    {
      "id": "contradiction_detection",
      "purpose": "Detect conflicting claims across documents.",
      "inputs": ["docs[]"],
      "outputs": ["contradiction_flag"],
      "evidence": ["contradiction.json"],
      "allowed_tools": ["none"],
      "resource_limits": {"max_model_calls": 0},
      "failure_modes": ["missed_split_doc"],
      "recovery": "flag_unknown",
      "approval": "none_in_research",
      "eligibility": "research-only",
      "maturity": "local_deterministic_prototype",
      "next_maturity": "sandboxed_operational",
      "evaluator": "research.evaluate:cross_doc_contradiction",
      "safety_controls": ["no_network"],
      "acceptance_criteria": ["split_doc_contradiction_detected_when_organization_allows"],
      "blocking_risks": ["false_negative"],
      "owner": "research",
      "dependencies": ["research_synthesis"]
    },
    {
      "id": "code_fixture",
      "purpose": "Inspect and modify files only inside a disposable fixture.",
      "inputs": ["fixture_files", "edit_spec"],
      "outputs": ["edited_files"],
      "evidence": ["diff_record"],
      "allowed_tools": ["in_memory_fs"],
      "resource_limits": {"max_model_calls": 0, "filesystem": "fixture_only"},
      "failure_modes": ["path_escape"],
      "recovery": "abort_no_write_outside_fixture",
      "approval": "none_in_research_fixture",
      "eligibility": "sandbox-eligible",
      "maturity": "local_deterministic_prototype",
      "next_maturity": "sandboxed_operational",
      "evaluator": "research.evaluate:code_fixture_edit",
      "safety_controls": ["fixture_scope", "no_production_paths"],
      "acceptance_criteria": ["edit_stays_in_fixture"],
      "blocking_risks": ["path_escape"],
      "owner": "research",
      "dependencies": ["bounded_planning"]
    },
    {
      "id": "test_generation_execution",
      "purpose": "Generate and execute checks on fixture code.",
      "inputs": ["fixture_files", "cases"],
      "outputs": ["test_report"],
      "evidence": ["test_report.json"],
      "allowed_tools": ["in_memory_eval"],
      "resource_limits": {"max_model_calls": 0},
      "failure_modes": ["generate_without_run"],
      "recovery": "report_not_run",
      "approval": "none_in_research",
      "eligibility": "sandbox-eligible",
      "maturity": "local_deterministic_prototype",
      "next_maturity": "sandboxed_operational",
      "evaluator": "research.evaluate:test_then_run",
      "safety_controls": ["no_shell_from_research"],
      "acceptance_criteria": ["cases_executed_when_executor_or_critic_present"],
      "blocking_risks": ["untrusted_generated_tests"],
      "owner": "research",
      "dependencies": ["code_fixture"]
    },
    {
      "id": "failure_recovery",
      "purpose": "Cancel in-flight work and mark incomplete state.",
      "inputs": ["run_state"],
      "outputs": ["cancelled_workers", "incomplete_flags"],
      "evidence": ["recovery.json"],
      "allowed_tools": ["population.cancel_all"],
      "resource_limits": {"max_model_calls": 0},
      "failure_modes": ["orphan_workers"],
      "recovery": "cancel_all_then_record",
      "approval": "none",
      "eligibility": "sandbox-eligible",
      "maturity": "local_deterministic_prototype",
      "next_maturity": "sandboxed_operational",
      "evaluator": "research.evaluate:recovery_after_interruption",
      "safety_controls": ["cancel_all", "no_auto_restart_production"],
      "acceptance_criteria": ["active_count_zero_after_cancel"],
      "blocking_risks": ["survivors"],
      "owner": "research",
      "dependencies": []
    },
    {
      "id": "evidence_reporting",
      "purpose": "Emit checkable artifacts for a run.",
      "inputs": ["task_results"],
      "outputs": ["candidate_json", "comparison_json"],
      "evidence": ["lineage_files"],
      "allowed_tools": ["research.experiment.record_candidate"],
      "resource_limits": {"max_model_calls": 0},
      "failure_modes": ["lost_failed_candidate"],
      "recovery": "retain_on_disk",
      "approval": "none",
      "eligibility": "sandbox-eligible",
      "maturity": "local_deterministic_prototype",
      "next_maturity": "sandboxed_operational",
      "evaluator": "tests.test_research_substrate.test_lineage_record",
      "safety_controls": ["no_delete_on_better_score"],
      "acceptance_criteria": ["failed_candidates_retained"],
      "blocking_risks": ["silent_discard"],
      "owner": "research",
      "dependencies": []
    },
    {
      "id": "uncertainty_communication",
      "purpose": "Surface uncertainty instead of a false answer.",
      "inputs": ["ambiguous_input"],
      "outputs": ["uncertainty_flag"],
      "evidence": ["ambiguity_record"],
      "allowed_tools": ["none"],
      "resource_limits": {"max_model_calls": 0},
      "failure_modes": ["false_certainty"],
      "recovery": "escalate",
      "approval": "user_if_blocking",
      "eligibility": "research-only",
      "maturity": "local_deterministic_prototype",
      "next_maturity": "sandboxed_operational",
      "evaluator": "research.evaluate:ambiguity_uncertainty",
      "safety_controls": ["critic_or_coordinator_required_for_ok"],
      "acceptance_criteria": ["no_silent_sense_pick_when_escalation_required"],
      "blocking_risks": ["confident_wrong"],
      "owner": "research",
      "dependencies": ["clarification"]
    },
    {
      "id": "user_approval_gates",
      "purpose": "Require explicit approval for irreversible or external actions.",
      "inputs": ["proposed_action"],
      "outputs": ["approved_or_denied"],
      "evidence": ["approval_record"],
      "allowed_tools": ["none"],
      "resource_limits": {"max_model_calls": 0},
      "failure_modes": ["skipped_gate"],
      "recovery": "deny_by_default",
      "approval": "always_for_external_or_production",
      "eligibility": "research-only",
      "maturity": "specified",
      "next_maturity": "local_deterministic_prototype",
      "evaluator": "manual_until_prototype",
      "safety_controls": ["deny_default", "no_production_auto_approve"],
      "acceptance_criteria": ["no_irreversible_action_without_record"],
      "blocking_risks": ["auto_approve"],
      "owner": "control_plane",
      "dependencies": ["auditability"]
    },
    {
      "id": "controlled_tool_invocation",
      "purpose": "Invoke only allowlisted tools inside a fixture.",
      "inputs": ["tool_name", "args"],
      "outputs": ["tool_result"],
      "evidence": ["tool_log"],
      "allowed_tools": ["in_memory_fs", "in_memory_eval"],
      "resource_limits": {"max_model_calls": 0, "network": false},
      "failure_modes": ["unknown_tool"],
      "recovery": "reject_tool",
      "approval": "none_for_allowlisted_research",
      "eligibility": "research-only",
      "maturity": "specified",
      "next_maturity": "local_deterministic_prototype",
      "evaluator": "manual_until_tool_registry",
      "safety_controls": ["allowlist", "no_shell"],
      "acceptance_criteria": ["unknown_tool_rejected"],
      "blocking_risks": ["shell_escape"],
      "owner": "research",
      "dependencies": ["user_approval_gates"]
    },
    {
      "id": "task_state_persistence",
      "purpose": "Persist run metadata under research/runs.",
      "inputs": ["experiment_meta"],
      "outputs": ["experiment.json"],
      "evidence": ["atomic_json"],
      "allowed_tools": ["research.experiment"],
      "resource_limits": {"max_model_calls": 0},
      "failure_modes": ["partial_write"],
      "recovery": "tmp_replace",
      "approval": "none",
      "eligibility": "sandbox-eligible",
      "maturity": "local_deterministic_prototype",
      "next_maturity": "sandboxed_operational",
      "evaluator": "tests.test_failure_recovery.test_atomic_write_leaves_valid_json",
      "safety_controls": ["atomic_write", "run_dir_isolation"],
      "acceptance_criteria": ["tmp_not_left_on_success"],
      "blocking_risks": ["torn_write"],
      "owner": "research",
      "dependencies": []
    },
    {
      "id": "auditability",
      "purpose": "Keep lineage, events, and scores for every candidate.",
      "inputs": ["candidate_record"],
      "outputs": ["candidate_*.json"],
      "evidence": ["lineage"],
      "allowed_tools": ["research.experiment.record_candidate"],
      "resource_limits": {"max_model_calls": 0},
      "failure_modes": ["missing_parent_ids"],
      "recovery": "reject_record",
      "approval": "none",
      "eligibility": "sandbox-eligible",
      "maturity": "local_deterministic_prototype",
      "next_maturity": "sandboxed_operational",
      "evaluator": "tests.test_research_substrate.test_lineage_record",
      "safety_controls": ["schema_aetheria_candidate_v1"],
      "acceptance_criteria": ["parent_ids_and_promotion_status_present"],
      "blocking_risks": ["unaudited_run"],
      "owner": "research",
      "dependencies": ["task_state_persistence"]
    },
    {
      "id": "safe_refusal_escalation",
      "purpose": "Refuse or escalate work outside the envelope.",
      "inputs": ["goal_record"],
      "outputs": ["refusal_or_escalation"],
      "evidence": ["refusal.json"],
      "allowed_tools": ["none"],
      "resource_limits": {"max_model_calls": 0},
      "failure_modes": ["over_acceptance"],
      "recovery": "refuse",
      "approval": "escalation_to_human",
      "eligibility": "research-only",
      "maturity": "specified",
      "next_maturity": "local_deterministic_prototype",
      "evaluator": "portfolio:safe_refusal",
      "safety_controls": ["default_refuse_production_and_credentials"],
      "acceptance_criteria": ["production_and_credential_requests_refused"],
      "blocking_risks": ["helpful_overreach"],
      "owner": "research",
      "dependencies": ["goal_interpretation", "user_approval_gates"]
    }
  ]
}
