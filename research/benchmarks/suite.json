{
  "schema": "aetheria_benchmark_v2",
  "name": "local_deterministic_v2",
  "network_access": false,
  "model_calls": 0,
  "visible_tasks": [
    "multi_doc_synthesis",
    "cross_doc_contradiction",
    "specialist_units",
    "dependent_planning",
    "code_fixture_edit",
    "test_then_run",
    "deliberate_error",
    "ambiguity_uncertainty",
    "duplication_trap",
    "early_stop_value",
    "resource_budget_compliance",
    "clean_shutdown",
    "safe_refusal",
    "revision_after_critique"
